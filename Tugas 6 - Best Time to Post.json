    {
      "parameters": {
        "jsCode": "// Tugas 6 - Langkah 2: Hitung Engagement Score tiap postingan\nconst BOBOT = { likes: 1, comments: 2, shares: 3 };\n\nfunction hitungEngagementScore(likes, comments, shares) {\n  return (likes * BOBOT.likes) + (comments * BOBOT.comments) + (shares * BOBOT.shares);\n}\n\nconst hasil = [];\nfor (const item of $input.all()) {\n  const row = item.json;\n  if (row['Jam Posting'] === '' || row['Jam Posting'] === undefined) continue; // lewati baris kosong\n\n  const jam = Number(row['Jam Posting']);\n  const likes = Number(row['Likes']) || 0;\n  const comments = Number(row['Comments']) || 0;\n  const shares = Number(row['Shares']) || 0;\n\n  hasil.push({\n    json: {\n      tanggal: row['Tanggal Posting'],\n      jam,\n      platform: row['Platform'],\n      likes,\n      comments,\n      shares,\n      engagementScore: hitungEngagementScore(likes, comments, shares)\n    }\n  });\n}\nreturn hasil;\n"
      },
      "id": "fa6850b2-1854-4267-8d73-3dcc56ec45d6",
      "name": "Hitung Engagement Score",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        480,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "// Tugas 6 - Langkah 3: Agregasi rata-rata engagement per jam, urutkan, ambil Top 5\nconst groups = {};\nconst totalData = $input.all().length;\n\nfor (const item of $input.all()) {\n  const d = item.json;\n  if (!groups[d.jam]) {\n    groups[d.jam] = { jam: d.jam, totalScore: 0, jumlahPosting: 0, totalLikes: 0, totalComments: 0, totalShares: 0, platforms: {} };\n  }\n  const g = groups[d.jam];\n  g.platforms[d.platform] = (g.platforms[d.platform] || 0) + 1;\n  g.totalScore += d.engagementScore;\n  g.totalLikes += d.likes;\n  g.totalComments += d.comments;\n  g.totalShares += d.shares;\n  g.jumlahPosting += 1;\n}\n\nconst round = (x) => Math.round(x * 100) / 100;\n\nconst urut = Object.values(groups)\n  .map(g => ({\n    jam: g.jam,\n    jamLabel: g.jam + ':00',\n    platformTerbanyak: Object.entries(g.platforms).sort((a, b) => b[1] - a[1])[0][0],\n    totalData,\n    rataRataEngagement: round(g.totalScore / g.jumlahPosting),\n    rataLikes: round(g.totalLikes / g.jumlahPosting),\n    rataComments: round(g.totalComments / g.jumlahPosting),\n    rataShares: round(g.totalShares / g.jumlahPosting),\n    jumlahPosting: g.jumlahPosting\n  }))\n  .sort((a, b) => b.rataRataEngagement - a.rataRataEngagement)  // terbesar -> terkecil\n  .slice(0, 5);                                                  // ambil 5 teratas\n\nreturn urut.map((x, i) => ({ json: { peringkat: i + 1, ...x } }));\n"
      },
      "id": "548cb26c-dd4d-4680-9463-7b819cc06911",
      "name": "Agregasi Rata-rata per Jam",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        720,
        0
      ]
