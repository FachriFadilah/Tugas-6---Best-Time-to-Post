    {
      "parameters": {
        "jsCode": "// Tugas 6 - Langkah 5: Format pesan Telegram (Markdown: bold = *teks*)\nconst top5 = $('Agregasi Rata-rata per Jam').all().map(i => i.json);\nconst medali = ['🥇', '🥈', '🥉', '4️⃣', '5️⃣'];\n\nconst tanggal = new Date().toLocaleDateString('id-ID', {\n  weekday: 'long', day: 'numeric', month: 'long', year: 'numeric'\n});\n\nlet pesan = `📊 *LAPORAN HARIAN: BEST TIME TO POST* 📊\\n`;\npesan += `🗓 ${tanggal}\\n\\n`;\npesan += `Berikut *5 jam terbaik* untuk posting berdasarkan rata-rata Engagement Score:\\n\\n`;\n\ntop5.forEach((d, i) => {\n  const jam = String(d.jam).padStart(2, '0');\n  pesan += `${medali[i]} *Jam ${jam}:00*\\n`;\n  pesan += `    🔥 Skor rata-rata: *${d.rataRataEngagement}*\\n`;\n  pesan += `    ❤️ ${d.rataLikes} likes  💬 ${d.rataComments} comments  🔁 ${d.rataShares} shares\\n`;\n  pesan += `    📝 Dari ${d.jumlahPosting} postingan\\n\\n`;\n});\n\npesan += `💡 *Rekomendasi:* jadwalkan konten terbaikmu di jam-jam tersebut!\\n`;\npesan += `_Skor = Likes x1 + Comments x2 + Shares x3_`;\n\nreturn [{ json: { pesan } }];\n"
      },
